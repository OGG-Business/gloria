# Configuration de la base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_transfers
DB_USER=postgres
DB_PASSWORD=password
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Configuration Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DATABASE=0

# Configuration Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=banking-transfers
KAFKA_AUTO_OFFSET_RESET=earliest

# Configuration Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=vault_token
VAULT_NAMESPACE=
VAULT_PATH=secret/banking-transfers

# Configuration Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=banking
KEYCLOAK_CLIENT_ID=banking-client
KEYCLOAK_CLIENT_SECRET=client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Configuration SWIFT
SWIFT_ENABLED=false
SWIFT_BIC=YOUR_BIC
SWIFT_CERT_PATH=/path/to/swift/cert.pem
SWIFT_KEY_PATH=/path/to/swift/key.pem
SWIFT_CA_PATH=/path/to/swift/ca.pem
SWIFT_ENDPOINT=https://test.swift.com
SWIFT_TIMEOUT=30000
SWIFT_RETRY_ATTEMPTS=3

# Configuration Mojaloop
MOJALOOP_ENABLED=false
MOJALOOP_ENDPOINT=https://test.mojaloop.io
MOJALOOP_API_KEY=your_api_key
MOJALOOP_TIMEOUT=30000

# Configuration de sécurité
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRATION=3600
ENCRYPTION_KEY=your_encryption_key_here_32_chars
MFA_ENABLED=true
SESSION_TIMEOUT_MINUTES=30

# Configuration des limites
MAX_TRANSFER_AMOUNT=1000000
DAILY_TRANSFER_LIMIT=10000000
KYC_REQUIRED_AMOUNT=10000
AML_SCREENING_ENABLED=true

# Configuration des logs
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/logs
LOG_RETENTION_DAYS=30

# Configuration du monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ELASTICSEARCH_ENABLED=true

# Configuration des notifications
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@banking-transfer.com

SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# Configuration des webhooks
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com
WEBHOOK_SECRET=your_webhook_secret

# Configuration de l'application
APP_NAME=Banking Transfer Platform
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_PORT=8080
APP_CONTEXT_PATH=/

# Configuration CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# Configuration des fichiers
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,jpg,jpeg,png
UPLOAD_PATH=/app/uploads

# Configuration des tests
TEST_MODE=false
MOCK_CONNECTORS=true
DRY_RUN_DEFAULT=true

# Configuration de la production (à modifier en production)
PRODUCTION_MODE=false
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Configuration des métriques
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/actuator/prometheus

# Configuration de la santé
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/actuator/health
HEALTH_CHECK_TIMEOUT=5000

# Configuration des migrations
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_VALIDATE_ON_MIGRATE=true

# Configuration du cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Configuration des timeouts
REQUEST_TIMEOUT=30000
CONNECTION_TIMEOUT=10000
READ_TIMEOUT=30000

# Configuration des pools de connexions
DB_POOL_INITIAL_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_IDLE=10

REDIS_POOL_MAX_TOTAL=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=5

# Configuration des alertes
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENTS=admin@banking-transfer.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/your/webhook

# Configuration de la sauvegarde
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# Configuration de la réplication
REPLICATION_ENABLED=false
REPLICATION_MASTER_HOST=
REPLICATION_SLAVE_HOSTS=

# Configuration des certificats
CERT_PATH=/app/certs
CERT_PASSWORD=your_cert_password

# Configuration des API externes
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_RATE_API_KEY=your_api_key

SANCTIONS_API_URL=https://api.sanctions.io
SANCTIONS_API_KEY=your_api_key

KYC_API_URL=https://api.kyc-provider.com
KYC_API_KEY=your_api_key

# Configuration des environnements spécifiques
# Développement
DEV_MODE=true
DEV_LOG_LEVEL=DEBUG
DEV_CORS_ALLOW_ALL=true

# Test
TEST_MODE=false
TEST_DB_NAME=banking_transfers_test
TEST_REDIS_DATABASE=1

# Production (à configurer séparément)
PROD_MODE=false
PROD_LOG_LEVEL=WARN
PROD_CORS_ALLOWED_ORIGINS=https://your-domain.com