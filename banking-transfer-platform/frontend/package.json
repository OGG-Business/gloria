{
  "name": "banking-transfer-frontend",
  "version": "1.0.0",
  "description": "Frontend React pour la plateforme de transferts bancaires",
  "private": true,
  "dependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.2.0",
    "web-vitals": "^3.4.0",
    "@keycloak/keycloak-js": "^22.0.0",
    "axios": "^1.5.0",
    "react-query": "^3.39.0",
    "react-hook-form": "^7.46.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "recharts": "^2.8.0",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "lucide-react": "^0.292.0",
    "react-dropzone": "^14.2.3",
    "react-table": "^7.8.0",
    "react-virtualized": "^9.22.5",
    "socket.io-client": "^4.7.4",
    "zustand": "^4.4.1",
    "react-intersection-observer": "^9.5.3",
    "react-error-boundary": "^4.0.11",
    "react-helmet-async": "^1.3.0",
    "react-window": "^1.8.8",
    "react-window-infinite-loader": "^1.0.7",
    "framer-motion": "^10.16.4",
    "react-spring": "^9.7.3",
    "react-transition-group": "^4.4.5",
    "react-modal": "^3.16.1",
    "react-tooltip": "^5.18.1",
    "react-select": "^5.8.0",
    "react-datepicker": "^4.21.0",
    "react-number-format": "^5.3.0",
    "react-phone-number-input": "^3.3.0",
    "react-iban": "^1.0.0",
    "iban": "^0.0.14",
    "swift-code": "^1.0.0",
    "currency-codes": "^2.1.0",
    "countries-list": "^2.6.1",
    "flag-icons": "^6.11.0",
    "react-flagkit": "^1.1.0",
    "react-intl": "^6.4.4",
    "i18next": "^23.5.1",
    "react-i18next": "^13.2.2",
    "i18next-browser-languagedetector": "^7.1.0",
    "i18next-http-backend": "^2.2.1",
    "workbox-webpack-plugin": "^7.0.0",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "cross-env": "^7.0.3",
    "serve": "^14.2.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.0.1",
    "rimraf": "^5.0.5",
    "copyfiles": "^2.4.1",
    "replace-in-file": "^6.3.5",
    "npm-run-all": "^4.1.5",
    "webpack-bundle-analyzer": "^4.9.1",
    "source-map-explorer": "^2.5.3",
    "react-app-rewired": "^2.2.1",
    "customize-cra": "^1.0.0",
    "babel-plugin-import": "^1.13.6",
    "babel-plugin-transform-remove-console": "^6.9.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:prod": "GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "analyze:source": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "serve": "serve -s build -l 3000",
    "dev": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && npm run serve\"",
    "clean": "rimraf build node_modules/.cache",
    "prebuild": "npm run clean",
    "prestart": "npm run type-check",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "proxy": "http://localhost:8080",
  "homepage": ".",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}