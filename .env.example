# =================================
# SwiftPay Environment Configuration
# =================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swiftpay
DB_USERNAME=swiftpay
DB_PASSWORD=swiftpay123
DB_SSL_MODE=prefer

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# HashiCorp Vault Configuration
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_TOKEN=dev-token
VAULT_SCHEME=http
VAULT_KV_PATH=secret/swiftpay

# OAuth2/OIDC Configuration (Keycloak)
OAUTH2_ISSUER_URI=http://localhost:8180/realms/swiftpay
OAUTH2_CLIENT_ID=swiftpay-backend
OAUTH2_CLIENT_SECRET=your-client-secret

# Encryption Configuration
ENCRYPTION_KEY_ALIAS=swiftpay-encryption-key
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# SWIFT Configuration
SWIFT_ENABLED=false
SWIFT_BIC=TESTBICXXX
SWIFT_ENDPOINT_URL=https://sandbox.swift.com/swift-api
SWIFT_CLIENT_CERT_PATH=/etc/ssl/certs/swift-client.p12
SWIFT_CLIENT_CERT_PASSWORD=your-cert-password
SWIFT_CA_CERT_PATH=/etc/ssl/certs/swift-ca.pem
SWIFT_MUTUAL_TLS_ENABLED=true

# Mojaloop Configuration
MOJALOOP_ENABLED=false
MOJALOOP_ENDPOINT_URL=https://sandbox.mojaloop.io
MOJALOOP_PARTICIPANT_ID=swiftpay
MOJALOOP_API_KEY=your-api-key

# KYC/AML Configuration
KYC_ENABLED=true
KYC_DOCUMENT_STORAGE_PATH=/var/swiftpay/kyc-documents
KYC_MAX_TRANSACTION_AMOUNT_USD=10000
AML_SANCTIONS_API_URL=https://api.sanctions-list.com
AML_SANCTIONS_API_KEY=your-sanctions-api-key

# Notification Configuration
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=swiftpay@example.com
SMTP_PASSWORD=smtp-password
SMS_PROVIDER=twilio
SMS_API_KEY=your-sms-api-key

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Application Configuration
APP_NAME=SwiftPay
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT_SECONDS=30

# Development/Testing
ENABLE_H2_CONSOLE=false
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_LOGGING=false

# Production Security (set in production only)
# JWT_SECRET=your-production-jwt-secret
# SESSION_SECRET=your-production-session-secret
# CSRF_SECRET=your-production-csrf-secret