# Backend
ENVIRONMENT=dev
SESSION_SECRET=change-me
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
TLS_CERT_PATH=/certs/dev-cert.pem
TLS_KEY_PATH=/certs/dev-key.pem

# OIDC (Keycloak)
OIDC_ISSUER_URL=http://keycloak:8080/realms/payments
OIDC_AUDIENCE=payments-api

# Vault
ault_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_TRANSIT_KEY=payments-aes-gcm

# Connectors
CONNECTOR_SWIFT_MODE=dry-run
CONNECTOR_SWIFT_ENDPOINT=https://bank.example.com/as4
CONNECTOR_SWIFT_TLS_CLIENT_CERT_PATH=/secrets/swift/client_cert.pem
CONNECTOR_SWIFT_TLS_CLIENT_KEY_PATH=/secrets/swift/client_key.pem
CONNECTOR_SWIFT_TLS_CA_CHAIN_PATH=/secrets/swift/ca_chain.pem
CONNECTOR_SWIFT_USERNAME=
CONNECTOR_SWIFT_PASSWORD=